; $VER: Install-TecnoballZ 0.93.1-amigaos3 (16.11.2026)
; The Amiga Installer script for TecnoballZ, an AmiCradle game port.
; Made by amicradle scripts/ports/port_installer.py: change the spec, not this file.
; Run it from its icon, beside the TecnoballZ drawer where the archive was unpacked.

(set @app-name "TecnoballZ")
(set #version "0.93.1-amigaos3")
(set #drawer "TecnoballZ")
(set #program "TecnoballZ")
(set #space 6836)  ; KB

(onerror
    (message (cat "TecnoballZ was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-TecnoballZ again to finish.")))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "TecnoballZ needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "TecnoballZ needs a 68040, 68060 or 68080 with an FPU. This Amiga has a " #cpu ".")))
(if (= (database "fpu") "NOFPU")
    (abort "TecnoballZ needs a 68040, 68060 or 68080 with an FPU. This Amiga has no FPU."))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The TecnoballZ drawer is not beside Install-TecnoballZ. Unpack the whole archive, then run Install-TecnoballZ from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The TecnoballZ drawer has no TecnoballZ in it. Unpack the whole archive again."))

(welcome "This installs TecnoballZ 0.93.1-amigaos3 for AmigaOS 3.2 on a 68040, 68060 or 68080 with an FPU.")

; where: the parent drawer
(set #default
    (if (= (exists "Work:Games" (noreq)) 2) "Work:Games"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the TecnoballZ drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called TecnoballZ in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": TecnoballZ needs 7 MB free.")))

; GFOpenGPU's modules: in LIBS:GFOpenGPU/, or copied there from LIBS:OpenGPU/
; (older instances have only that); none is copied before all are found
(if (and (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/SDL2.module" (noreq)) 1))
    (abort "TecnoballZ needs GFOpenGPU's SDL2.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-TecnoballZ again. Nothing has been installed."))
(if (<> (exists "LIBS:GFOpenGPU" (noreq)) 2)
    (makedir "LIBS:GFOpenGPU"))
(if (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1)
    (copyfiles
        (prompt "Copying SDL2.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copyfiles-help)
        (source "LIBS:OpenGPU")
        (dest "LIBS:GFOpenGPU")
        (choices "SDL2.module")))
(complete 20)

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (exists (tackon #dest "user") (noreq))
    (set #kept (if (= #kept "") "user" (cat #kept "|" "user"))))
(if (exists (tackon #dest "tecnoballz.hi") (noreq))
    (set #kept (if (= #kept "") "tecnoballz.hi" (cat #kept "|" "tecnoballz.hi"))))
(if (exists (tackon #dest "Screenshots") (noreq))
    (set #kept (if (= #kept "") "Screenshots" (cat #kept "|" "Screenshots"))))
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying TecnoballZ")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating TecnoballZ. Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "TecnoballZ.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "TecnoballZ.info")))

(set #later "")
(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. TecnoballZ would have gone in " #dest "."))
    (message (cat "TecnoballZ 0.93.1-amigaos3 is installed in " #dest "."
                  "\n\nTo start it, open the TecnoballZ drawer and double-click the TecnoballZ icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept "."))
                  (if (= #later "") "" (cat "\n\nStill to add to the drawer: " #later ". Run Install-TecnoballZ again to fetch or copy it.")))))
(exit (quiet))
