# TecnoballZ 0.93.1 for AmigaOS 3.x, 68040/68060 + FPU, on OpenGPU's SDL 1.2
# (sdl12-compat).
#
#   make -f amiga/Makefile.amigaos -j2 dist \
#        STOVE=/path/to/openamigagcc-16.2.0-open4 \
#        NDK=/path/to/OpenNDK/Include_H SDLKIT=/path/to/opengpu-sdk \
#        DEPS=/path/to/m68k-amigaos
#
# src/Makefile.am's sources, with amiga/config.h for configure's. SDLKIT
# is the OpenGPU developer kit: libSDL.a, sdl12-compat on SDL2.module. It
# has no SDL_image or SDL_mixer 1.2: amiga/sdl_image_lite.c (the game's
# palette PNGs, on libpng) and the Team's amiga/sdl_mixer_lite.c (WAV, with
# libmikmod 3.3.16 for the music: amiga/libmikmod, its player, ProTracker
# and XM loaders and no-sound driver) stand in. TinyXML is the Team's copy from
# the Gigalomania port (amiga/tinyxml). DEPS has the Team's static libpng
# and zlib (/mnt/amigachrome/team2/deps/m68k-amigaos).

STOVE   ?= $(HOME)/CradleLab/toolchain/openamigagcc-16.2.0-open4-x86_64-linux
NDK     ?= $(HOME)/CradleLab/gfopensdk/OpenNDK/Include_H
SDLKIT  ?= /mnt/amigachrome/team2/deps/opengpu-sdk
DEPS    ?= /mnt/amigachrome/team2/deps/m68k-amigaos
CC      = $(STOVE)/bin/m68k-amigaos-gcc
CXX     = $(STOVE)/bin/m68k-amigaos-g++
STRIP   = $(STOVE)/bin/m68k-amigaos-strip
CPU     ?= -m68040 -m68881
# -fno-tree-loop-distribute-patterns: GCC 16's loop miscompile (the kit's
# sdl2-config gives it for GCC 16 too).
OPT     ?= -O2 -fomit-frame-pointer -fno-tree-loop-distribute-patterns

BUILD   = build/amigaos
OBJDIR  = $(BUILD)/obj
PROG    = TecnoballZ
OUT     = dist/TecnoballZ

DEFS    = -D__amigaos__ -DNDEBUG -DHAVE_CONFIG_H -DDATADIR=\"PROGDIR:data\" \
          -DSCOREFILE=\"PROGDIR:tecnoballz.hi\"
INC     = -Iamiga -Iamiga/include -Iamiga/include/SDL -Iamiga/tinyxml -Iamiga/libmikmod \
          -Iinclude -I$(SDLKIT)/include/SDL -I$(SDLKIT)/include -I$(DEPS)/include -I$(NDK)
CFLAGS  = -noixemul $(OPT) $(CPU) -fno-common -MMD -MP -w
CXXFLAGS = $(CFLAGS) $(DEFS) $(INC) -std=gnu++98 -include amiga/amiga_prefix.hpp
LDFLAGS = -noixemul $(CPU)
LIBS    = -L$(SDLKIT)/lib -L$(DEPS)/lib -lSDL -lpng -lz -lpthread -lm

CXXSRC  = $(wildcard src/*.cc) amiga/tinyxml/tinyxml.cpp amiga/tinyxml/tinyxmlerror.cpp \
          amiga/tinyxml/tinyxmlparser.cpp
CSRC    = amiga/stack.c amiga/sdl_image_lite.c amiga/sdl_mixer_lite.c
MIKMOD_SRC = $(wildcard amiga/libmikmod/*.c)
MIKMOD_CFLAGS = -noixemul -O2 $(CPU) -fno-common -MMD -MP -w -DMIKMOD_BUILD -DMIKMOD_STATIC \
          -DHAVE_LIMITS_H -DHAVE_SNPRINTF -DHAVE_UNISTD_H -DWORDS_BIGENDIAN=1 \
          -DNO_DEPACKERS -DNO_HQMIXER -Iamiga/libmikmod -I$(NDK)

OBJS    = $(CXXSRC:%.cc=$(OBJDIR)/%.o) $(CSRC:%.c=$(OBJDIR)/%.o) $(MIKMOD_SRC:%.c=$(OBJDIR)/%.o)
OBJS   := $(OBJS:%.cpp=$(OBJDIR)/%.o)
ICONS   = $(wildcard amiga/icons/*.info)

all: $(BUILD)/$(PROG)

$(BUILD)/$(PROG): $(OBJS)
	$(CXX) $(LDFLAGS) -o $@.debug $(OBJS) $(LIBS)
	$(STRIP) -o $@ $@.debug

$(OBJDIR)/%.o: %.cc
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

$(OBJDIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

$(OBJDIR)/amiga/libmikmod/%.o: amiga/libmikmod/%.c
	@mkdir -p $(dir $@)
	$(CC) $(MIKMOD_CFLAGS) -std=gnu99 -c -o $@ $<

$(OBJDIR)/amiga/%.o: amiga/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -std=gnu99 -Iamiga/include/SDL -Iamiga/libmikmod -I$(SDLKIT)/include/SDL \
	  -I$(DEPS)/include -I$(NDK) -DMIKMOD_STATIC -Wall -c -o $@ $<

# The drawer: the program; data/ with the game's src/TecnoballZ (pictures,
# levels, sounds and modules, as upstream installs them); the high scores
# (tecnoballz.hi, upstream's empty table), ReadMe and the licences. The
# settings go in the drawer's user/.
dist: $(BUILD)/$(PROG) $(ICONS) AMIGA_PORT.md
	rm -rf $(OUT) && mkdir -p $(OUT)
	cp $(BUILD)/$(PROG) $(OUT)/
	cp -R src/TecnoballZ $(OUT)/data
	find $(OUT)/data -name Makefile.am -delete
	cp tecnoballz.hi $(OUT)/
	cp AMIGA_PORT.md $(OUT)/ReadMe
	cp COPYING $(OUT)/COPYING.txt
	cp amiga/libmikmod/COPYING.LIB $(OUT)/COPYING-libmikmod.txt
	cp amiga/icons/TecnoballZ.info amiga/icons/ReadMe.info $(OUT)/
	cp amiga/icons/ReadMe.info $(OUT)/COPYING.txt.info
	cp amiga/icons/ReadMe.info $(OUT)/COPYING-libmikmod.txt.info
	cp amiga/icons/Folder.info $(OUT)/data.info
	cp amiga/icons/TecnoballZ-drawer.info dist/TecnoballZ.info

-include $(OBJS:.o=.d)

clean:
	rm -rf $(BUILD)

.PHONY: all clean dist
